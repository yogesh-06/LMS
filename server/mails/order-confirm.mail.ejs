<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Your ELearning order is confirmed!</title>

    <style>
      @media only screen and (max-width: 620px) {
        .email-shell {
          width: 100% !important;
        }

        .email-header {
          padding: 26px 24px !important;
        }

        .email-content {
          padding: 24px !important;
        }

        .email-footer {
          padding: 18px 24px 20px !important;
        }
      }
    </style>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1e293b;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f4f7fb"
    >
      <tr>
        <td align="center" style="padding: 24px 16px">
          <table
            class="email-shell"
            role="presentation"
            width="600"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              width: 600px;
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 16px;
              overflow: hidden;
              box-shadow: 0 10px 28px rgba(15, 23, 42, 0.1);
            "
          >
            <!-- Header -->
            <tr>
              <td
                class="email-header"
                style="
                  padding: 30px 40px;
                  background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
                  text-align: center;
                "
              >
                <div
                  style="
                    display: inline-block;
                    padding: 6px 12px;
                    border: 1px solid rgba(255, 255, 255, 0.32);
                    border-radius: 20px;
                    color: #dbeafe;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                    text-transform: uppercase;
                  "
                >
                  ELearning
                </div>

                <h1
                  style="
                    margin: 12px 0 0;
                    color: #ffffff;
                    font-size: 27px;
                    line-height: 34px;
                    font-weight: 700;
                  "
                >
                  Your ELearning order is confirmed!
                </h1>

                <p
                  style="
                    margin: 6px 0 0;
                    color: #e0e7ff;
                    font-size: 15px;
                    line-height: 21px;
                  "
                >
                  And we're just as excited as you are.
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td class="email-content" style="padding: 28px 40px 24px">
                <p
                  style="
                    margin: 0 0 8px;
                    color: #1e293b;
                    font-size: 16px;
                    line-height: 23px;
                  "
                >
                  Hello <strong><%= user %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 18px;
                    color: #475569;
                    font-size: 14px;
                    line-height: 21px;
                  "
                >
                  Thank you for your purchase. Your order has been successfully
                  confirmed. Here's what you ordered:
                </p>

                <!-- Order Details -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    background-color: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    overflow: hidden;
                  "
                >
                  <!-- Order Information -->
                  <tr>
                    <td
                      colspan="3"
                      style="
                        padding: 13px 16px;
                        background-color: #f1f5f9;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      <table
                        role="presentation"
                        width="100%"
                        cellspacing="0"
                        cellpadding="0"
                        border="0"
                      >
                        <tr>
                          <td
                            style="
                              color: #64748b;
                              font-size: 12px;
                              line-height: 18px;
                            "
                          >
                            <strong>Order #:</strong>
                            <span style="color: #1e293b">
                              <%= order._id %>
                            </span>
                          </td>

                          <td
                            align="right"
                            style="
                              color: #64748b;
                              font-size: 12px;
                              line-height: 18px;
                            "
                          >
                            <strong>Order Date:</strong>
                            <span style="color: #1e293b">
                              <%= order.date %>
                            </span>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- Table Heading -->
                  <tr>
                    <td
                      style="
                        padding: 10px 16px;
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                        text-transform: uppercase;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      Item
                    </td>

                    <td
                      align="center"
                      style="
                        padding: 10px 8px;
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                        text-transform: uppercase;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      Qty
                    </td>

                    <td
                      align="right"
                      style="
                        padding: 10px 16px 10px 8px;
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                        text-transform: uppercase;
                        border-bottom: 1px solid #e2e8f0;
                      "
                    >
                      Cost
                    </td>
                  </tr>

                  <!-- Course -->
                  <tr>
                    <td
                      style="
                        padding: 14px 16px;
                        color: #334155;
                        font-size: 14px;
                        line-height: 20px;
                        font-weight: 500;
                      "
                    >
                      <%= order.name %>
                    </td>

                    <td
                      align="center"
                      style="
                        padding: 14px 8px;
                        color: #334155;
                        font-size: 14px;
                        line-height: 20px;
                      "
                    >
                      <%= order.quantity %>
                    </td>

                    <td
                      align="right"
                      style="
                        padding: 14px 16px 14px 8px;
                        color: #334155;
                        font-size: 14px;
                        line-height: 20px;
                        white-space: nowrap;
                      "
                    >
                      <%= order.price %>
                    </td>
                  </tr>

                  <!-- Divider -->
                  <tr>
                    <td
                      colspan="3"
                      style="padding: 0 16px; border-top: 1px solid #e2e8f0"
                    ></td>
                  </tr>

                  <!-- Subtotal -->
                  <tr>
                    <td
                      colspan="2"
                      align="right"
                      style="
                        padding: 10px 8px 3px 16px;
                        color: #64748b;
                        font-size: 13px;
                      "
                    >
                      Subtotal:
                    </td>

                    <td
                      align="right"
                      style="
                        padding: 10px 16px 3px 8px;
                        color: #334155;
                        font-size: 13px;
                        font-weight: 600;
                        white-space: nowrap;
                      "
                    >
                      <%= order.price %>
                    </td>
                  </tr>

                  <!-- Total -->
                  <tr>
                    <td
                      colspan="2"
                      align="right"
                      style="
                        padding: 3px 8px 14px 16px;
                        color: #1e293b;
                        font-size: 14px;
                        font-weight: 700;
                      "
                    >
                      Total:
                    </td>

                    <td
                      align="right"
                      style="
                        padding: 3px 16px 14px 8px;
                        color: #1d4ed8;
                        font-size: 16px;
                        font-weight: 700;
                        white-space: nowrap;
                      "
                    >
                      <%= order.price %>
                    </td>
                  </tr>
                </table>

                <!-- Confirmation Message -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="margin-top: 16px"
                >
                  <tr>
                    <td
                      style="
                        padding: 11px 14px;
                        background-color: #f0fdf4;
                        border-left: 4px solid #22c55e;
                        border-radius: 5px;
                      "
                    >
                      <p
                        style="
                          margin: 0;
                          color: #166534;
                          font-size: 13px;
                          line-height: 19px;
                        "
                      >
                        <strong>Your order is confirmed.</strong>
                        You can now access your purchased course from your
                        ELearning account.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                class="email-footer"
                style="
                  padding: 18px 40px 22px;
                  border-top: 1px solid #e2e8f0;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    color: #64748b;
                    font-size: 12px;
                    line-height: 18px;
                  "
                >
                  If you have any questions, please contact our support team at
                  <a
                    href="mailto:support@becodemy.com"
                    style="
                      color: #2563eb;
                      font-weight: 700;
                      text-decoration: none;
                    "
                  >
                    support@becodemy.com
                  </a>
                </p>

                <p style="margin: 6px 0 0; color: #94a3b8; font-size: 11px">
                  &copy; <%= new Date().getFullYear() %> ELearning. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
